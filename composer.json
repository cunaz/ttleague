{
    "name": "ttleague/ttleague",
    "description": "WordPress-Plugin für den Spielbetrieb einer Tischtennis-Liga: Meisterschaft, Cup, Ranglistenturnier, Spieler, Wertungszahl. Entwickelt für den SFFS Firmensport Region Zürich.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "TTLeague\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TTLeague\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "setup-phpcs": "phpcs --config-set installed_paths ../../wp-coding-standards/wpcs,../../phpcsstandards/phpcsutils,../../phpcsstandards/phpcsextra",
        "post-install-cmd": [
            "@setup-phpcs"
        ],
        "post-update-cmd": [
            "@setup-phpcs"
        ]
    }
}
