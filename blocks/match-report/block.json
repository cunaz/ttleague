{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ttleague/match-report",
	"version": "0.1.0",
	"title": "Matchreport",
	"category": "ttleague",
	"icon": "clipboard",
	"description": "Begegnung mit Aufstellungen und allen Spielen; ohne Angabe die Begegnung aus der Adresse.",
	"keywords": [
		"ttleague",
		"tischtennis"
	],
	"textdomain": "ttleague",
	"attributes": {
		"fixture": {
			"type": "integer",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "ttleague-editor",
	"style": "ttleague-frontend"
}
