{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ttleague/group",
	"version": "0.1.0",
	"title": "Meisterschaft: Gruppe",
	"category": "ttleague",
	"icon": "editor-table",
	"description": "Volle Tabelle und Spielplan/Resultate einer Gruppe; ohne Angabe die Gruppe aus der Adresse.",
	"keywords": [
		"ttleague",
		"tischtennis"
	],
	"textdomain": "ttleague",
	"attributes": {
		"season": {
			"type": "string",
			"default": ""
		},
		"group": {
			"type": "string",
			"default": ""
		},
		"show": {
			"type": "string",
			"enum": [
				"all",
				"table",
				"schedule"
			],
			"default": "all"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "ttleague-editor",
	"style": "ttleague-frontend"
}
